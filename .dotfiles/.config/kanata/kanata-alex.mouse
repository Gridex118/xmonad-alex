(defcfg
  linux-dev /dev/input/by-id/usb-30fa_USB_Optical_Mouse-event-mouse
  linux-output-device-name "Kanata-Alex-Mouse"
  process-unmapped-keys yes
  movemouse-inherit-accel-state yes
  concurrent-tap-hold yes
  rapid-event-delay 5
)

(defsrc
  mfwd        mwu
        mlft  mmid mrgt
  mbck        mwd
)

(deflayermap (mod-mouse)
  mfwd @mmod
  mbck @mgimp)

(defalias
  mmod (tap-dance 200
         ((tap-hold-press 200 200 mfwd lmet)
		  lctl
		  lsft)))

(deflayer gimp
  _     ]
     +  _  -
  _     [
)

(deflayermap mousetab
  mwu tab
  mwd S-tab)

(defalias
  niritab (tap-hold-press 200 200
            A-tab
			(multi lalt (layer-toggle mousetab))))

(deflayer niri
   _       M-r
      M-o  M-q  @niritab
   _        _
)

(defalias
  mniri (tap-hold-press 200 200
          M-c
		  (layer-toggle niri)))

(defalias
  mgimp (tap-dance 200
  		  ((tap-hold-press 200 200
          	  mbck (layer-toggle gimp))
			@mniri)))
